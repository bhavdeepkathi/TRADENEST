// Prisma Schema for AI Service
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AIRecommendation {
  id        String   @id @default(cuid())
  userId    String?
  productId String
  type      String
  score     Float
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([productId])
  @@index([type])
}

model TrendingProduct {
  id          String   @id @default(cuid())
  productId   String   @unique
  score       Float
  windowStart DateTime
  windowEnd   DateTime
  createdAt   DateTime @default(now())

  @@index([windowStart, windowEnd])
}

model SalesForecast {
  id          String   @id @default(cuid())
  productId   String?
  categoryId  String?
  period      String
  forecast    Json
  createdAt   DateTime @default(now())

  @@index([productId, period])
  @@index([categoryId, period])
}

model CustomerBehavior {
  id        String   @id @default(cuid())
  userId    String
  eventType String
  eventData Json
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
}

model FraudAlert {
  id        String   @id @default(cuid())
  userId    String?
  orderId   String?
  type      String
  severity  String
  details   Json
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([orderId])
  @@index([severity])
}