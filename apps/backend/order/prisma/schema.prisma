// Prisma Schema for Order Service
generator client {
  provider      = "prisma-client-js"
  output        = "../../../../node_modules/@tradenest/order-prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ShipmentStatus {
  PENDING_PICKUP
  CLAIMED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_IN_TRANSIT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentProvider {
  COD
  RAZORPAY
  STRIPE
  UPI
  WALLET
}

enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  INACTIVE
  REJECTED
}

model Seller {
  id         String      @id
  userId     String      @unique
  storeName  String
  products   Product[]
  inventories Inventory[]
}

model Category {
  id       String    @id
  name     String
  slug     String
  products Product[]
}

model Product {
  id              String        @id
  sellerId        String
  seller          Seller        @relation(fields: [sellerId], references: [id])
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])
  title           String
  slug            String        @unique
  brand           String
  subcategory     String
  description     String
  price           Decimal       @db.Decimal(12, 2)
  mrp             Decimal?      @db.Decimal(12, 2)
  discountPercent Int
  images          String[]
  tags            String[]
  status          ProductStatus
  ratingAvg       Float?
  reviewCount     Int
  inventory       Inventory?
  cartItems       CartItem[]
  orderItems      OrderItem[]
}

model Inventory {
  id                String   @id
  productId         String   @unique
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerId          String
  seller            Seller   @relation(fields: [sellerId], references: [id])
  quantity          Int
  reserved          Int
  lowStockThreshold Int
  updatedAt         DateTime
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([productId])
}

model Order {
  id              String       @id @default(cuid())
  userId          String
  status          OrderStatus  @default(PENDING)
  subtotal        Decimal      @db.Decimal(12, 2)
  tax             Decimal      @db.Decimal(12, 2)
  shipping        Decimal      @db.Decimal(12, 2)
  discount        Decimal      @db.Decimal(12, 2) @default(0)
  total           Decimal      @db.Decimal(12, 2)
  couponCode      String?
  shippingAddress Json
  billingAddress  Json
  isResellerOrder Boolean      @default(false)
  resellerUserId  String?
  customerBillAmount Decimal?  @db.Decimal(12, 2)
  resellerMargin  Decimal?     @db.Decimal(12, 2)
  deliveryOtp     String?
  items           OrderItem[]
  payment         Payment?
  invoice         Invoice?
  shipment        Shipment?
  returns         ReturnRequest[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerId  String
  title     String
  price     Decimal  @db.Decimal(12, 2)
  quantity  Int
  discount  Decimal  @db.Decimal(12, 2) @default(0)

  @@index([orderId])
  @@index([sellerId])
  @@index([productId])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      PaymentProvider
  providerRef   String
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("INR")
  status        PaymentStatus @default(INITIATED)
  rawResponse   Json?
  refund        Refund?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([providerRef])
}

model Refund {
  id          String   @id @default(cuid())
  paymentId   String   @unique
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(12, 2)
  reason      String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  processedAt DateTime?
}

model Invoice {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pdfKey    String
  number    String   @unique
  createdAt DateTime @default(now())
}

model ReturnRequest {
  id              String       @id @default(cuid())
  orderId         String
  order           Order        @relation(fields: [orderId], references: [id])
  sellerId        String
  userId          String
  reason          String
  status          ReturnStatus @default(PENDING)
  rejectionReason String?
  images          String[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([sellerId])
  @@index([userId])
}

model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  description String
  type        String
  value       Decimal  @db.Decimal(10, 2)
  minOrder    Decimal? @db.Decimal(12, 2)
  maxDiscount Decimal? @db.Decimal(12, 2)
  startAt     DateTime
  endAt       DateTime
  usageLimit  Int      @default(1)
  usedCount   Int      @default(0)
  isActive    Boolean  @default(true)
  usages      CouponUsage[]
}

model CouponUsage {
  id        String  @id @default(cuid())
  couponId  String
  coupon    Coupon  @relation(fields: [couponId], references: [id])
  userId    String
  orderId   String?
  createdAt DateTime @default(now())
  @@unique([couponId, userId])
}

model Shipment {
  id                 String         @id @default(cuid())
  orderId            String         @unique
  order              Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderNumber        String         @unique
  driverId           String?
  driverName         String?
  driverPhone        String?
  driverVehicle      String?
  status             ShipmentStatus @default(PENDING_PICKUP)
  customerName       String
  customerPhone      String
  deliveryAddress    String
  city               String         @default("Mumbai")
  pincode            String         @default("400001")
  distance           String         @default("2.5 km")
  itemsCount         Int            @default(1)
  totalWeight        String         @default("1.0 kg")
  isReseller         Boolean        @default(false)
  customerBillAmount Decimal        @db.Decimal(12, 2) @default(0)
  platformBaseCost   Decimal        @db.Decimal(12, 2) @default(0)
  deliveryOtp        String?
  isReturnPickup     Boolean        @default(false)
  returnReason       String?
  returnHubAddress   String?
  claimedAt          DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([status])
  @@index([driverId])
  @@index([createdAt])
}

model Wallet {
  id String @id @default(cuid())
  userId String @unique
  balance Decimal @db.Decimal(12, 2) @default(0)
  updatedAt DateTime @updatedAt
  transactions WalletTxn[]
}

model WalletTxn {
  id String @id @default(cuid())
  walletId String
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type String
  amount Decimal @db.Decimal(12, 2)
  description String
  reference String?
  createdAt DateTime @default(now())
  @@index([walletId])
}
