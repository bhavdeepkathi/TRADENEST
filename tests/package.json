{
  "name": "tradenest-tests",
  "private": true,
  "scripts": {
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:load": "k6 run tests/load/api-load-test.js",
    "test:load:staging": "BASE_URL=https://api.staging.tradenest.io AUTH_TOKEN=$STAGING_TOKEN k6 run tests/load/api-load-test.js",
    "test:load:prod": "BASE_URL=https://api.tradenest.io AUTH_TOKEN=$PROD_TOKEN k6 run tests/load/api-load-test.js",
    "test:chaos:staging": "kubectl apply -f tests/chaos/tradenest-chaos-engine.yaml -n tradenest-staging",
    "test:chaos:prod": "kubectl apply -f tests/chaos/tradenest-chaos-engine.yaml -n tradenest-prod",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:contract",
    "test:ci": "npm run test:unit && npm run test:integration && npm run test:contract && npm run test:e2e"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^13.0.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.2.0",
    "@types/k6": "^0.44.0",
    "cypress": "^13.7.0",
    "k6": "^0.47.0",
    "testcontainers": "^10.9.0",
    "vitest": "^1.3.0",
    "@vitest/coverage-v8": "^1.3.0"
  }
}