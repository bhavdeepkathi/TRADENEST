# TRADENEST Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# Application
# ===========================================
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000/api

# ===========================================
# Database (PostgreSQL)
# ===========================================
DATABASE_URL=postgresql://tradenest:tradenest_dev@localhost:5432/tradenest
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tradenest
DB_USER=tradenest
DB_PASSWORD=tradenest_dev

# ===========================================
# Redis Cache
# ===========================================
REDIS_URL=redis://:redis_dev@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev

# ===========================================
# JWT Authentication
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ===========================================
# Email (Mailhog for dev)
# ===========================================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@tradenest.local

# ===========================================
# File Storage (MinIO for dev, AWS S3 for prod)
# ===========================================
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=tradenest
MINIO_USE_SSL=false

# AWS S3 (production)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_PRODUCTS=tradenest-products
AWS_S3_BUCKET_INVOICES=tradenest-invoices
AWS_S3_BUCKET_DOCS=tradenest-docs

# ===========================================
# Payment Gateways
# ===========================================
# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# UPI (generic)
UPI_MERCHANT_ID=
UPI_MERCHANT_KEY=

# ===========================================
# AI/ML Services
# ===========================================
AI_MODEL_ENDPOINT=http://localhost:8000
AI_API_KEY=

# ===========================================
# Monitoring
# ===========================================
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3001
LOKI_URL=http://localhost:3100

# ===========================================
# Feature Flags
# ===========================================
ENABLE_AI_RECOMMENDATIONS=true
ENABLE_PWA=true
ENABLE_DARK_MODE=true